{
  "name": "@kywk/react-relive",
  "version": "0.1.0",
  "description": "Framework-independent React component for Relive GPX and photo replay",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit --strict --types react --module NodeNext --moduleResolution NodeNext --target ES2022 test/types.ts"
  },
  "dependencies": {
    "@kywk/relive": "^0.1.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "5.24.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@kywk/relive": "file:../..",
    "@types/react": "^19.3.0",
    "jsdom": "24.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "kywk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kywk/relive.git",
    "directory": "packages/react-relive"
  }
}
